# Maintainer: IdeaGitTool contributors
pkgname=ideagittool-bin
_pkgname=ideagittool
pkgver=0.4.12
pkgrel=1
pkgdesc="Lightweight standalone IdeaGitTool Git client (prebuilt)"
arch=('x86_64')
url="https://github.com/huiyi-li/idea_GitTools"
license=('Apache-2.0')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'git'
  'libsecret'
)
options=('!strip')
source=("IdeaGitTool_${pkgver}_linux-x86_64.tar.gz::${url}/releases/download/${pkgver}/IdeaGitTool_${pkgver}_linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/IdeaGitTool_${pkgver}_linux-x86_64"
  install -Dm755 "bin/ideagittool-desktop" "${pkgdir}/usr/bin/ideagittool-desktop"
  install -Dm644 "share/ideagittool.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"
  install -Dm644 "share/ideagittool.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/${_pkgname}.png"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
  install -Dm644 "NOTICE" "${pkgdir}/usr/share/licenses/${_pkgname}/NOTICE"
  install -Dm644 "licenses/UPSTREAM_LICENSE.txt" "${pkgdir}/usr/share/licenses/${_pkgname}/UPSTREAM_LICENSE.txt"
}
