# Keep source, build manifests, required assets and release documentation at the root.
/*
!/.gitignore
!/LICENSE
!/NOTICE
!/README.md
!/licenses/
!/docs/
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/src/
!/src-tauri/
!/scripts/
!/test/

# Keep only the Rust project inputs under src-tauri.
/src-tauri/*
!/src-tauri/Cargo.toml
!/src-tauri/Cargo.lock
!/src-tauri/build.rs
!/src-tauri/tauri.conf.json
!/src-tauri/capabilities/
!/src-tauri/icons/
!/src-tauri/src/

# Release notes are maintained documentation. Plans and temporary reports stay local.
/docs/*
!/docs/RELEASE_0.4.0.md
!/docs/RELEASE_0.4.1.md
**/*.md
!/README.md
!/docs/RELEASE_0.4.0.md
!/docs/RELEASE_0.4.1.md

# Dependencies, generated code, packages and build output.
node_modules/
target/
gen/
dist/
release/
coverage/
.cache/
.vite/
*.tsbuildinfo
*.map
*.exe
*.dll
*.pdb
*.obj
*.o
*.a
*.lib
*.msi
*.zip
*.7z
*.vsix

# Local settings, credentials and temporary files.
.idea/
.vscode/
.env
.env.*
*.pem
*.key
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
